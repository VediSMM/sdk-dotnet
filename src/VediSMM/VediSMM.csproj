<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>VediSMM</AssemblyName>
    <RootNamespace>VediSMM</RootNamespace>
    <PackageId>VediSMM</PackageId>
    <Version>0.2.0</Version>
    <Authors>VediSMM</Authors>
    <Company>VediSMM</Company>
    <Description>Native .NET client for the VediSMM public user API v1.</Description>
    <PackageTags>vedismm;api;sdk;social-media</PackageTags>
    <PackageProjectUrl>https://vedismm.ru/docs/api</PackageProjectUrl>
    <RepositoryUrl>https://github.com/VediSMM/sdk-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
